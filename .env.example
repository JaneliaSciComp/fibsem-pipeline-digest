# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# Classic Personal Access Token with scopes: repo, read:project, read:org
# See README.md for step-by-step instructions on obtaining one.
GITHUB_TOKEN=

# Optional: override the project board (org login and project number).
# Defaults match the JaneliaSciComp reconstruction board.
FIBSEM_ORG=JaneliaSciComp
FIBSEM_PROJECT_NUMBER=9
